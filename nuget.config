<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<!--
	  Every dependency, BrandUp.* packages included, is published on nuget.org. Clearing the inherited
	  sources keeps a private feed from a user-level config out of restore, so there is a single source
	  and central package management needs no package source mapping (NU1507).
	-->
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
	</packageSources>

</configuration>
