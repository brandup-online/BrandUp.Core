		<PackageTags>cqrs;result;testing;brandup</PackageTags>
		<RootNamespace>BrandUp.Testing</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BrandUp.Core\BrandUp.Core.csproj" />
	</ItemGroup>

</Project>
