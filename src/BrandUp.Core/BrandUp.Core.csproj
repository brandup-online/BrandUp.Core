<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Product>BrandUp.Core</Product>
		<Description>Base framework for .NET development: a universal Result structure and lightweight CQRS infrastructure (commands, queries and items) on top of Microsoft.Extensions.DependencyInjection.</Description>
		<PackageTags>cqrs;result;command;query;domain;mediator;brandup</PackageTags>
		<RootNamespace>BrandUp</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Localization" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Options" />
	</ItemGroup>

</Project>
